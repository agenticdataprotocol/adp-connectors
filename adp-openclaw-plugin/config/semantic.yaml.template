# Semantic Manifest Template
# Maps physical data sources (from physical.yaml) to ADP resources and
# defines the "Agent's View" of fields.
#
# Copy this file as semantic.yaml and customize for your environment.
#
# IMPORTANT:
# - You MUST define resources explicitly.
# - Each resource has one sourceDefinition; use multiple resources if you need
#   to expose multiple tables/collections.

version: "1.0.0"

# List of resource definitions. Each entry binds a resourceId to one backend
# and one source definition.
#
# resources:
#   # Example: relational table as a QUERY-only resource
#   - resourceId: "com.example:my_table"
#     intentClasses: ["QUERY"]   # e.g. ["QUERY"], ["LOOKUP"], ["INGEST"], ["REVISE"], or ["*"]
#     version: 1
#     description: "My table resource"
#     backendId: "my_database"   # must match a backend id in physical.yaml
#     sourceDefinition:
#       source: "my_table"       # table/view/collection name, or prefix for object storage
#       fields:
#         - fieldId: "id"
#           type: "STRING"
#           description: "Primary key"
#         - fieldId: "name"
#           type: "STRING"
#           description: "Name field"
#
#   # Example: local filesystem directory as a resource
#   # For BLOB_STORAGE backends with provider "local", each resource maps to a
#   # subdirectory under the backend's uri. The full path is: {uri}/{source}
#   #
#   # The following metadata fields are provided automatically by convention -
#   # do NOT define them in the fields list:
#   #
#   #   path           (STRING)    - Relative path from the source root
#   #   size           (INTEGER)   - Size in bytes (0 for directories)
#   #   last_modified  (TIMESTAMP) - Last modification time
#   #   created_at     (TIMESTAMP) - Creation time
#   #   content_type   (STRING)    - MIME type (inferred from file extension)
#   #   is_directory   (BOOLEAN)   - Whether the entry is a subdirectory
#   #
#   # For LOOKUP intent, the response also includes:
#   #   content           (STRING) - File content (text or base64-encoded)
#   #   content_encoding  (STRING) - "utf-8" or "base64"
#   #
#   # Intent semantics for local filesystem resources:
#   #   LOOKUP  - Read a specific file by path
#   #   QUERY   - List entries in a directory (metadata only, no content).
#   #             Use a "path EQ <dir>" predicate to list a subdirectory;
#   #             omit it to list the source root.
#   #   INGEST  - Create a new file or subdirectory (path may contain "/")
#   #   REVISE  - Overwrite an existing file's content
#   #
#   - resourceId: "com.example:reports"
#     intentClasses: ["LOOKUP", "QUERY", "INGEST", "REVISE"]
#     version: 1
#     description: "Report files"
#     backendId: "local_files"   # must match a BLOB_STORAGE backend in physical.yaml
#     sourceDefinition:
#       source: "reports"        # subdirectory under the backend's uri
